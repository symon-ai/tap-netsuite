{
  "_comment": [
    "SuiteQL query metadata, one entry per stream. Field-level column expressions live in",
    "object_definition.json under 'suiteqlExpr' and are generated from this file by",
    "scripts/generate_suiteql_mapping.py -- edit here, then regenerate.",
    "",
    "table:          FROM clause, including any joins needed by refs.",
    "alias:          alias of the primary table.",
    "keyColumn:      unique ascending column used for keyset pagination.",
    "replication:    column backing the stream's replication key, or null for FULL_TABLE.",
    "where:          static predicates, e.g. narrowing the transaction table to one record type.",
    "columns:        display name -> SuiteQL expression, for fields the default derivation",
    "                (lowercased SOAP name) gets wrong.",
    "refs:           display name -> {column, table, nameColumn} for fields that SOAP returns as",
    "                a nested RecordRef. Selected as two columns and reassembled into a dict.",
    "sublists:       display name -> sublist query spec. 'customFields' is handled specially: the",
    "                account's custom columns are discovered at runtime.",
    "unsupported:    fields with no SuiteQL equivalent established yet. Emitted as null with a",
    "                warning rather than silently wrong data.",
    "verified:       whether every expression in this stream has been confirmed against a real",
    "                NetSuite account by scripts/suiteql_parity.py."
  ],
